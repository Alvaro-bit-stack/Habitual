# Copy this file to .env for local development, or use your hosting provider's secret settings.
# Never commit a real API key.
GEMINI_API_KEY=replace-with-a-server-side-key
# Comma-separated: the next model is tried when one is unavailable or out of quota.
GEMINI_MODEL=gemini-3.5-flash,gemini-3.8-flash,gemini-3-flash-preview,gemini-flash-latest
PORT=8787
